DATABASE_URL="file:./dev.db"
AUTH_SECRET="generate-a-long-random-string"
AUTH_URL="http://localhost:3000"

# Express API that owns Google OAuth and JWT sessions.
# Google start: GET {AUTH_API_URL}/auth/google/start
# Authorized redirect URI on the backend: http://localhost:3000/auth/google/callback
# Set FRONTEND_URL on Express to this Next app origin (often http://localhost:3001).
AUTH_API_URL="http://localhost:3000"

# Unused by the Google button after Express integration. Kept for existing NextAuth files.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
