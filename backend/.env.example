NODE_ENV=development
PORT=3000
# Local dev: mongodb://127.0.0.1:27017/trimmer_auth
# MongoDB Atlas (free M0): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/trimmer_auth?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/trimmer_auth
CORS_ORIGIN=
AUTH_API_URL=http://localhost:3000
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_API_KEY=

# Use independent, randomly generated secrets of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
OAUTH_STATE_SECRET=replace-with-another-random-secret-of-at-least-32-characters
RECOVERY_KEY_SECRET=replace-with-a-third-random-secret-of-at-least-32-characters

# Create an OAuth "Web application" client in Google Cloud Console.
# Add GOOGLE_REDIRECT_URI as an Authorized redirect URI in that client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
FRONTEND_URL=http://localhost:3001

# Verification emails (Gmail SMTP). Enable 2-Step Verification, then create an
# App Password at https://myaccount.google.com/apppasswords and paste it below.
# Leave SMTP_USER/SMTP_PASS empty in development to print links to the console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
EMAIL_VERIFICATION_TTL_HOURS=24
